# Copy to .env.local and fill in. .env.local is gitignored - it never leaves this machine.
# Both scripts and the daily workflow read exactly these names.

DISCORD_TOKEN=
DISCORD_GUILD_ID=

# Optional:
# DISCORD_TOKEN_TYPE=user            # only if TOKEN is a personal account token
# DISCORD_EXCLUDE_CHANNELS=111,222   # channel ids discovery should skip
